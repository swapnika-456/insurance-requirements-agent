# ==============================================================================
# Insurance Requirements Agent (IRA) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and insert your real credentials.
# NEVER commit the real .env file into version control!
# ==============================================================================

# LLM Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Application Environment (development, staging, production)
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Storage Locations
DATABASE_URL=sqlite:///./data/app.db
CHROMA_PERSIST_DIRECTORY=./data/chroma
UPLOAD_DIRECTORY=./data/uploads

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000,http://localhost:5000
